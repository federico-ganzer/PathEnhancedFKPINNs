#!/bin/bash
# Generated by scripts/submit.py from slurm/array.sbatch.tmpl. Do not edit the generated copy.
# Each task runs the code checked out when it starts; its env.json records the commit.
#SBATCH --job-name={job_name}
#SBATCH --account={account}
#SBATCH --partition={partition}
#SBATCH --nodes=1
#SBATCH --gres=gpu:{gpus}
#SBATCH --time={walltime}
#SBATCH --array=0-{last_index}
#SBATCH --requeue
#SBATCH --output={log_dir}/%x_%A_%a.out
#SBATCH --error={log_dir}/%x_%A_%a.err
{extra_sbatch}

set -euo pipefail
cd {repo}
{module_lines}

# One process per GPU; let XLA grow memory instead of preallocating 75%.
export XLA_PYTHON_CLIENT_PREALLOCATE=false

uv run --frozen --extra {cuda_extra} python scripts/run.py {run_args} --task-index "$SLURM_ARRAY_TASK_ID"
